{
  "compilerOptions": {
    // Bun 直接执行 TS，无需编译产物，类型检查交给 tsc --noEmit
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/carddav/worker.ts",
    "src/carddav/worker.test.ts",
    "src/carddav/admin.ts",
    "src/carddav/admin.test.ts",
    "src/carddav/admin-ui.ts",
    "src/carddav/store.ts",
    "src/carddav/worker-types.ts",
    "src/carddav/dav-write.ts"
  ]
}
