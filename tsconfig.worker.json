{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": [
    "src/carddav/worker.ts",
    "src/carddav/worker.test.ts",
    "src/carddav/admin.ts",
    "src/carddav/admin.test.ts",
    "src/carddav/admin-ui.ts",
    "src/carddav/store.ts",
    "src/carddav/worker-types.ts",
    "src/carddav/dav-write.ts",
    "src/carddav/merge.ts",
    "src/carddav/merge.test.ts",
    "src/carddav/types.ts"
  ]
}
